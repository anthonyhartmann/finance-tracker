# Google Sheets API key (read-only, for shell scripts)
GOOGLE_SHEETS_API_KEY=

# Google API credentials (OAuth 2.0 or Service Account)
# For personal spreadsheets, OAuth 2.0 is easiest. Download client_secret.json from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Or use a Service Account (share your sheet with the service account email)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials.json

# Your spreadsheet ID (from the URL)
SPREADSHEET_ID=

# Plaid credentials
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox

# Webhook (use ngrok to expose local server to Plaid)
WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/webhook

# Calendar
CALENDAR_ID=primary

# Misc
TIMEZONE=America/New_York
SYNC_START_DATE=2026-07-01
